<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Global: the cart page and Luma's REST checkout both carry the shopper's cookies. -->
    <event name="sales_quote_collect_totals_before">
        <observer name="variant_connector_sync_visitor_ids" instance="Variant\Connector\Observer\SyncVisitorIds"/>
    </event>
    <event name="sales_model_service_quote_submit_before">
        <observer name="variant_connector_copy_visitor_ids_to_order"
                  instance="Variant\Connector\Observer\CopyVisitorIdsToOrder"/>
    </event>
</config>
