<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <!-- The Variant integration's own REST routes. New routes in Variant's modules go
                     under this resource, which the integration already holds, so adding one never
                     changes integration.xml (which would reset the integration's token). -->
                <resource id="Variant_Connector::api"
                          title="Variant API"
                          translate="title"
                          sortOrder="910"/>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Variant_Connector::config"
                                      title="Variant"
                                      translate="title"
                                      sortOrder="900"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
