<!-- Magento_Backend::store is already granted to the Variant integration (integration.xml), so
     a connected store needs no reauthorization for these. -->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/variant/loading-mode" method="PUT">
        <service class="Variant\Connector\Api\LoadingModeInterface" method="save"/>
        <resources>
            <resource ref="Magento_Backend::store"/>
        </resources>
    </route>
    <route url="/V1/variant/loading-mode" method="GET">
        <service class="Variant\Connector\Api\LoadingModeInterface" method="get"/>
        <resources>
            <resource ref="Magento_Backend::store"/>
        </resources>
    </route>
    <!-- Orders for test results: who placed each (Variant's visitor ids), totals, lines, refunds.
         Read-only, and only for tokens holding Variant_Connector::api (the Variant integration,
         and admins with full access). -->
    <route url="/V1/variant/orders" method="GET">
        <service class="Variant\Connector\Api\OrdersInterface" method="getUpdatedSince"/>
        <resources>
            <resource ref="Variant_Connector::api"/>
        </resources>
    </route>
</routes>
