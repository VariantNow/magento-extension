<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Global: the cart page and Luma's REST checkout both carry the shopper's cookie. -->
    <event name="sales_quote_collect_totals_before">
        <observer name="variant_pricing_sync_active_keys" instance="Variant\Pricing\Observer\SyncActiveKeys"/>
        <!-- After the sync, so the price test reads the keys this request carries. -->
        <observer name="variant_pricing_apply_price_tests" instance="Variant\Pricing\Observer\ApplyPriceTests"/>
    </event>
    <event name="sales_model_service_quote_submit_before">
        <observer name="variant_pricing_copy_to_order" instance="Variant\Pricing\Observer\CopyToOrder"/>
    </event>
</config>
